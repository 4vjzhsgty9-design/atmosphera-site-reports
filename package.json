{
  "name": "atmosphera-site-reports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "db:install": "bash scripts/install-supabase-cli.sh",
    "db:start": ".tools/supabase start --exclude studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime",
    "db:stop": ".tools/supabase stop",
    "db:test": ".tools/supabase test db",
    "db:reset": ".tools/supabase db reset",
    "bootstrap:director": "node --env-file=.env.local scripts/bootstrap-director.mjs",
    "test:boundary": "playwright test --config=playwright.boundary.config.ts",
    "test:connected": "playwright test --config=playwright.connected.config.ts",
    "db:test-env": "node scripts/local-test-env.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
