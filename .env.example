# Default preserves the original browser-local demonstration.
APP_MODE=demo
# Connected mode must be configured explicitly; never silently falls back to demo.
APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_URL=
# Publishable key, or legacy anon JWT. NOT service_role / sb_secret.
SUPABASE_PUBLISHABLE_KEY=
# Optional server-only secret / legacy service_role key. Only employee invitation
# and the one-time bootstrap script need it. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=
